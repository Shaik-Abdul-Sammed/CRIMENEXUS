# ==============================================================================
# CRIMENEXUS Environment Configuration Template
# Copy this file to .env before starting services:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Frontend Client Configuration (Vite + React)
# ------------------------------------------------------------------------------
VITE_APP_TITLE="CRIMENEXUS - AI Criminal Network Intelligence"
VITE_API_MOCK_MODE=false
VITE_API_BASE_URL="http://localhost:8000/api/v1"
VITE_API_LATENCY_MS=0
VITE_MAP_TILE_STYLE="https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json"

# ------------------------------------------------------------------------------
# PostgreSQL Relational Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=crimenexus
POSTGRES_PORT=5432
# Local connection string (when running backend outside Docker):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crimenexus"
POSTGRES_URL="postgresql://postgres:postgres@localhost:5432/crimenexus"

# ------------------------------------------------------------------------------
# Neo4j Graph Database Configuration
# ------------------------------------------------------------------------------
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER=neo4j
NEO4J_PASSWORD=crimenexus123

# ------------------------------------------------------------------------------
# Backend Security & JWT Authentication
# ------------------------------------------------------------------------------
JWT_SECRET_KEY="crimenexus_super_secure_jwt_secret_key_change_in_prod_2026"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ------------------------------------------------------------------------------
# Redis Streaming & Real-Time Caching Configuration
# ------------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379/0"

# ------------------------------------------------------------------------------
# Local Generative AI & Legal Drafting Engine (Ollama / Local LLM)
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL="http://localhost:11434"
LLM_MODEL_NAME="mistral:7b-instruct"

# ------------------------------------------------------------------------------
# CCTNS & ICJS National Police Grid Integration
# ------------------------------------------------------------------------------
CCTNS_BASE_URL="https://cctns.police.gov.in/api/v2"
CCTNS_API_KEY="CCTNS-SECURE-KEY-STATE-POLICE-2026"

# ------------------------------------------------------------------------------
# Production Observability & Error Tracking
# ------------------------------------------------------------------------------
SENTRY_DSN=""
ENVIRONMENT="production"
APP_VERSION="1.0.0"

# ------------------------------------------------------------------------------
# SMS / WhatsApp Field Alert System (Twilio & MSG91)
# ------------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER="+14155238886"
MSG91_API_KEY=""
MSG91_SENDER_ID="CRIMNX"
SMS_RATE_LIMIT_PER_HOUR=5

# ------------------------------------------------------------------------------
# Threat Intelligence Feeds (STIX 2.1 / TAXII 2.1)
# ------------------------------------------------------------------------------
TAXII_SERVER_URL="https://mock.cert-in.org.in/taxii2/"
TAXII_COLLECTION_ID="cert-in-ioc-collection"
TAXII_USERNAME=""
TAXII_PASSWORD=""

# ------------------------------------------------------------------------------
# Blockchain Evidence Notary (Merkle Root Anchoring)
# ------------------------------------------------------------------------------
MERKLE_NOTARY_ENABLED=true

# ------------------------------------------------------------------------------
# Operational Excellence & Disaster Recovery (v3.0)
# ------------------------------------------------------------------------------
CRIMENEXUS_BACKUP_DIR="/tmp/crimenexus_backups"
BACKUP_RETENTION_DAYS=30
TELECOM_GATEWAY_REDIS_STREAM="telecom.cdr.live"
NAFIS_BIOMETRIC_AIRGAP=true
LOC_EXPIRY_THRESHOLD_DAYS=15
BNSS_STATUTORY_DEADLINE_DAYS=90
